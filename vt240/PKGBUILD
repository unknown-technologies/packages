pkgname='vt240'
pkgdesc='DEC VT240 terminal emulator'
pkgver=r69.g54b7d9b
pkgrel=1
url="https://github.com/unknown-technologies/vt240"
depends=(glibc libgl glfw hicolor-icon-theme)
makedepends=(git glslang bin2o)
license=(GPL-3.0-or-later)
arch=(x86_64 aarch64)
source=('git+https://github.com/unknown-technologies/vt240'
        'vt240.desktop'
        'vt240-24.png'
        'vt240-96.png')
sha256sums=('SKIP'
            'cd63cb3760c46edaf98b54d15702b6126b5f4d054b5713dd45024f8540f5ac3b'
            '92f5b04a902f6e730622d232e072c91644163b752def5fa7c3029475a74a86b0'
            '71218421614572a19293741b44cd5745485ea56fc3471d26d6232bfe4315ee86')

pkgver() {
	cd "${srcdir}/vt240"

	echo "r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
}

build() {
	cd "${srcdir}/vt240"

	make NDEBUG=1

	gzip -ck9 "man/vt240.1" > "build/vt240.1.gz"
	gzip -ck9 "man/vt240.7" > "build/vt240.7.gz"
	gzip -ck9 "man/vt240_pg.7" > "build/vt240_pg.7.gz"
}

package() {
	install -dm755 "${pkgdir}/usr/bin"
	install -dm755 "${pkgdir}/usr/share/applications"
	install -dm755 "${pkgdir}/usr/share/icons/hicolor/24x24/apps"
	install -dm755 "${pkgdir}/usr/share/icons/hicolor/96x96/apps"
	install -dm755 "${pkgdir}/usr/share/man/man1"
	install -dm755 "${pkgdir}/usr/share/man/man7"
	install -m755 "${srcdir}/vt240/vt240" "${pkgdir}/usr/bin"
	install -m644 "${srcdir}/vt240.desktop" "${pkgdir}/usr/share/applications"
	install -m644 "${srcdir}/vt240-24.png" "${pkgdir}/usr/share/icons/hicolor/24x24/apps/vt240.png"
	install -m644 "${srcdir}/vt240-96.png" "${pkgdir}/usr/share/icons/hicolor/96x96/apps/vt240.png"
	install -m644 "${srcdir}/vt240/build/vt240.1.gz" "${pkgdir}/usr/share/man/man1/vt240.1.gz"
	install -m644 "${srcdir}/vt240/build/vt240.7.gz" "${pkgdir}/usr/share/man/man7/vt240.7.gz"
	install -m644 "${srcdir}/vt240/build/vt240_pg.7.gz" "${pkgdir}/usr/share/man/man7/vt240_pg.7.gz"
}
